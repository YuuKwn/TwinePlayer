<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/app_icon.ico</ApplicationIcon>
    <AssemblyName>TwinePlayer.Native</AssemblyName>
    <RootNamespace>TwinePlayer.Native.App</RootNamespace>
    <Version>1.1.0</Version>
    <Product>TwinePlayer</Product>
    <InformationalVersion>1.1.0</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <ProjectReference Include="../TwinePlayer.Core/TwinePlayer.Core.csproj" />
    <ProjectReference Include="../TwinePlayer.Persistence/TwinePlayer.Persistence.csproj" />
    <ProjectReference Include="../TwinePlayer.Player/TwinePlayer.Player.csproj" />
    <Content Update="Assets/app_icon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="Assets/app_icon.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/BrowserStorage/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../../flutter_app/assets/input_lab.html" Link="Assets/InputLab/input_lab.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Unpackaged dotnet publish does not include the generated app PRI/XBFs
       automatically with this SDK. They are required by LoadComponent. -->
  <Target Name="PublishApplicationXamlResources" AfterTargets="ComputeFilesToPublish">
    <Error Condition="!Exists('$(TargetDir)$(AssemblyName).pri')" Text="The generated WinUI application PRI is missing." />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(TargetDir)$(AssemblyName).pri">
        <RelativePath>$(AssemblyName).pri</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <_ApplicationXbf Include="$(TargetDir)**/*.xbf" />
      <ResolvedFileToPublish Include="@(_ApplicationXbf)">
        <RelativePath>%(_ApplicationXbf.RecursiveDir)%(_ApplicationXbf.Filename)%(_ApplicationXbf.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>

